# ---------------------------------------------------------------------------
# Compiled output
# ---------------------------------------------------------------------------
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binary, built with `go test -c`
*.test
# Coverage output (go test -coverprofile)
*.out
# Built service binaries at the repository root
/manager
/producer
/consumer
/game2048
/migration-manager

# ---------------------------------------------------------------------------
# Go toolchain
# ---------------------------------------------------------------------------
# Go workspace files
go.work
go.work.sum
# Local build and module caches (regenerated by the toolchain)
.gocache/
.gomodcache/
# Dependency directories. Uncomment to vendor dependencies.
# vendor/

# ---------------------------------------------------------------------------
# Local configuration and secrets
# ---------------------------------------------------------------------------
# Environment file with local settings; never commit it.
.env
.env.*
!.env.example
# Kubeconfigs and credentials
kubeconfig
*.kubeconfig
*.pem
*.key

# ---------------------------------------------------------------------------
# Generated results
# ---------------------------------------------------------------------------
# Benchmark output written by scripts/benchmark.go
benchmark_results.*
# Local checkpoint and transfer artifacts
*.tar
*.tar.gz
checkpoint-*.tar

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*~
/tmp/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Generated HTML is ignored, but the dashboard page is source code that the
# Go server embeds, so it must stay tracked.
!pkg/migration/dashboard.html
