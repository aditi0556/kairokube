# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS builder

ARG CGO_ENABLED=0
ARG GOOS=linux
ARG GOARCH=amd64

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/game2048 ./cmd/game2048
COPY pkg/ ./pkg/

RUN go build -ldflags="-s -w" -o /game2048 ./cmd/game2048

FROM alpine:3.20

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /
COPY --from=builder /game2048 /game2048
USER appuser
ENTRYPOINT ["/game2048"]
