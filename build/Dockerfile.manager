FROM golang:1.26.8-alpine3.22 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/migration-manager ./cmd/migration-manager
COPY pkg/ ./pkg/
RUN go build -o /manager ./cmd/migration-manager

FROM alpine:3.22
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /
COPY --from=builder /manager /manager
USER appuser
ENTRYPOINT ["/manager"]
