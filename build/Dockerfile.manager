# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS builder

ARG CGO_ENABLED=0
ARG GOOS=linux
ARG GOARCH=amd64

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/migration-manager ./cmd/migration-manager
COPY pkg/ ./pkg/
RUN go build -ldflags="-s -w" -o /manager ./cmd/migration-manager

FROM alpine:3.20
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /
COPY --from=builder /manager /manager
USER appuser
ENTRYPOINT ["/manager"]
